PR_NUMBER=15843
PR_NAME=michatnihkk-crypto
# NikGapps Configuration File (Android 16 - v38)
# Disesuaikan untuk AxionOS: Ganti aplikasi bawaan + Gmail, Chrome, Maps + Pertahankan Launcher Bawaan

Version=38

# Pengaturan Instalasi
# 0 = Sesuai pengaturan di bawah | 1 = Instal semua paket
mode=0

# Menghapus aplikasi AOSP bawaan yang digantikan oleh Google Apps (1 = Hapus, 0 = Pertahankan)
WipeDalvikCache=1
WipeRuntimePermissions=0
InstallPartition=default
use_zip_config=0
gms_optimization=0

# ==========================================
# CORE (Wajib untuk Google Play Store & Layanan Google)
# ==========================================
Core=1
>>ExtraFiles=1
>>GooglePlayStore=1
>>GoogleServicesFramework=1
>>ContactsSyncAdapter=1
>>CalendarSyncAdapter=1
>>GmsCore=1

# ==========================================
# BASIC (Mengganti Telepon, Kontak, Pesan & Utilitas Dasar)
# ==========================================
Basic=1
>>DigitalWellbeing=1
>>VancedManager=0
>>GoogleMessages=1
>>GoogleDialer=1
>>GoogleContacts=1
>>CarrierServices=1
>>GoogleClock=1

# ==========================================
# OMNI (Mengganti Kalkulator, Kalender, Foto, Keyboard & Tambah Maps)
# ==========================================
Omni=1
>>SetupWizard=1
>>GoogleRestore=1
>>GoogleCalculator=1
>>GoogleDrive=0
>>GoogleMaps=1
>>GoogleLocationHistory=1
>>GooglePhotos=1
>>DeviceHealthServices=1
>>GBoard=1
>>GoogleCalendar=1
>>GoogleKeep=0

# ==========================================
# STOCK (Mengganti File Manager, WebView, TTS & Tambah Gmail)
# ==========================================
Stock=1
>>PixelLauncher=0
>>DevicePersonalizationServices=1
>>GoogleWallpaper=0
>>QuickAccessWallet=1
>>GoogleTTS=1
>>MarkupGoogle=1
>>GoogleTalkback=0
>>Velvet=1
>>GoogleSounds=1
>>GoogleRecorder=1
>>Gmail=1
>>GoogleFiles=1
>>StorageManager=1
>>DocumentsUIGoogle=1

# ==========================================
# FULL (Tambahan Google Chrome menggantikan Browser AOSP)
# ==========================================
Full=1
>>GoogleChrome=1
>>WebViewGoogle=1
>>TrichromeLibrary=1
>>AndroidAuto=0
>>GoogleFeedback=0
>>GooglePartnerSetup=1
>>AndroidDevicePolicy=0

# ==========================================
# ADDONS (Opsional - Dinonaktifkan agar ringan)
# ==========================================
Pixelize=0
YouTube=0
YouTubeMusic=0
GoogleDocs=0
GoogleSheets=0
GoogleSlides=0
GoogleMeet=0
GoogleFi=0
