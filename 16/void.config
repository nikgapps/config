# NikGapps configuration file
# Customized for Pixel 7 (panther) on Vanilla Halcyon OS Android 16 QPR2
# Full compatibility configured for Premium Photos Tools, Google Camera, Password Manager, & Song Search.

AndroidVersion=16
Version=38
LogDirectory=default
InstallPartition=default
Mode=install
WipeDalvikCache=1
WipeRuntimePermissions=1
ExecuteBackupRestore=1
UseZipConfig=0
OverwriteWithZipConfig=0
GmsOptimization=0
GenerateLogs=1

# ==========================================
# MANDATORY CORE SERVICES & FRAMEWORKS
# ==========================================
Core=1
>>ExtraFiles=1
>>GooglePlayStore=1
>>GoogleServicesFramework=1
>>GoogleContactsSyncAdapter=1
>>GoogleCalendarSyncAdapter=1
>>GmsCore=1

SetupWizard=1
>>SetupWizard=1
>>GoogleRestore=1
>>GoogleOneTimeInitializer=1

# ==========================================
# USER REQUESTED APPS & TARGET DEPENDENCIES
# ==========================================
GoogleChrome=1
>>GoogleChrome=1
>>WebViewGoogle=1
>>TrichromeLibrary=1

GoogleSearch=1
>>Velvet=1
>>Gemini=1

GoogleDialer=1
GoogleContacts=1
GoogleCalendar=1
GoogleMaps=1
Gmail=1
GBoard=1
GooglePhotos=1
GoogleKeep=1

# ==========================================
# PIXEL EXCLUSIVE PLATFORM LIBRARIES (CRUCIAL)
# ==========================================
PixelSpecifics=1
>>PixelLauncher=1
>>DevicePersonalizationServices=1
>>GoogleWallpaper=1
>>QuickAccessWallet=1
>>SettingsServices=1
>>PrivateComputeServices=1
>>PixelThemes=1
>>EmojiWallpaper=1
>>PixelWeather=1
>>AICore=1

GoogleSounds=1
DeviceHealthServices=1
MarkupGoogle=1

# ==========================================
# OPTIONAL UNREQUESTED APPS (TURNED OFF)
# ==========================================
DigitalWellbeing=0
GoogleMessages=0
CarrierServices=0
GoogleClock=0
GoogleCalculator=0
Drive=0
GoogleLocationHistory=0
PlayGames=0
GoogleRecorder=0
GoogleFiles=0
GoogleTTS=0
DeviceSetup=0
AndroidAuto=0
GoogleFeedback=0
GooglePartnerSetup=0
AndroidDevicePolicy=0

# CoreGo Settings
CoreGo=0
GoogleGo=0
AssistantGo=0
MapsGo=0
NavigationGo=0
GalleryGo=0
GmailGo=0

# Addon Settings
PixelSetupWizard=0
Meet=0
GoogleDocs=0
GoogleSheets=0
GoogleSlides=0
YouTube=0
YouTubeMusic=0
Books=0
GoogleTalkback=0
GooglePersonalSafety=0
