PR_NUMBER=15751
PR_NAME=igorkostic
# NikGapps configuration file

AndroidVersion=16
Version=38

# Log i particija
LogDirectory=default
InstallPartition=default
Mode=install

# Ponasanje instalera
WipeDalvikCache=1
WipeRuntimePermissions=1
ExecuteBackupRestore=1
UseZipConfig=0
OverwriteWithZipConfig=0
GmsOptimization=0
GenerateLogs=1

# Core - baza, bez ovoga nista ne radi
Core=1
>>ExtraFiles=1
>>GooglePlayStore=1
>>GoogleServicesFramework=1
>>GoogleContactsSyncAdapter=1
>>GoogleCalendarSyncAdapter=1
>>GmsCore=1

# Telefonija i osnovne aplikacije
DigitalWellbeing=1
GoogleMessages=1
GoogleDialer=1
GoogleContacts=1
CarrierServices=1
GoogleClock=1

# Setup wizard - roditelj gasi ceo blok
SetupWizard=0
>>SetupWizard=1
>>GoogleRestore=1
>>GoogleOneTimeInitializer=1

# Google aplikacije
GoogleCalculator=1
Drive=0
GoogleMaps=0
GoogleLocationHistory=1
GooglePhotos=1
DeviceHealthServices=1
GBoard=1
GoogleCalendar=1
GoogleKeep=0

# Pixel sloj
PixelSpecifics=1
>>PixelLauncher=1
>>DevicePersonalizationServices=1
>>GoogleWallpaper=1
>>QuickAccessWallet=1
>>SettingsServices=1
>>PrivateComputeServices=1
>>PixelThemes=1
>>EmojiWallpaper=1
>>PixelWeather=0
>>AICore=1

# Ostalo
PlayGames=1
GoogleRecorder=0

# Files
GoogleFiles=1
>>GoogleFiles=1
>>StorageManager=1
>>DocumentsUIGoogle=1

MarkupGoogle=1
GoogleTTS=1

# Pretraga
GoogleSearch=1
>>Velvet=1
>>Gemini=0

GoogleSounds=1

# Chrome i WebView
GoogleChrome=1
>>GoogleChrome=1
>>WebViewGoogle=1
>>TrichromeLibrary=1

# Razno
Gmail=0
DeviceSetup=1
AndroidAuto=1
GoogleFeedback=0
GooglePartnerSetup=1
AndroidDevicePolicy=0

# Go varijante - lightweight parnjaci punih paketa gore, ostaju 0
CoreGo=0
GoogleGo=0
AssistantGo=0
MapsGo=0
NavigationGo=0
GalleryGo=0
GmailGo=0

# Addoni - nemaju AOSP parnjaka, cista velicina
PixelSetupWizard=1
Meet=0
GoogleDocs=0
GoogleSheets=0
GoogleSlides=0
YouTube=0
YouTubeMusic=0
Books=0
GoogleTalkback=1
GooglePersonalSafety=1

# NikGapps debloater starts here
Contacts
