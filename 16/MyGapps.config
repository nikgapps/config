# NikGapps configuration file
# Configured for Omni + Gmail + Google Search (Velvet) + Gemini AI Assistant

AndroidVersion=16
Version=38

LogDirectory=default
InstallPartition=default
Mode=install
WipeDalvikCache=1
WipeRuntimePermissions=1
ExecuteBackupRestore=1
UseZipConfig=0
OverwriteWithZipConfig=0
GmsOptimization=0
GenerateLogs=1

# --- BASE OMNI PACK (KEEP ENABLED) ---

Core=1
>>ExtraFiles=1
>>GooglePlayStore=1
>>GoogleServicesFramework=1
>>GoogleContactsSyncAdapter=1
>>GoogleCalendarSyncAdapter=1
>>GmsCore=1

DigitalWellbeing=1
GoogleMessages=1
GoogleDialer=1
GoogleContacts=1
CarrierServices=1
GoogleClock=1

SetupWizard=1
>>SetupWizard=1
>>GoogleRestore=1
>>GoogleOneTimeInitializer=1

GoogleCalculator=1
Drive=1
GoogleMaps=1
GoogleLocationHistory=1
GooglePhotos=1
DeviceHealthServices=1
GBoard=1
GoogleCalendar=1
GoogleKeep=1

# --- DISABLE ALL STOCK PIXEL COMPONENTS ---
# (This excludes Pixel Launcher, Sound Amplifier / Markup, etc.)

PixelSpecifics=0
>>PixelLauncher=0
>>DevicePersonalizationServices=0
>>GoogleWallpaper=0
>>QuickAccessWallet=0
>>SettingsServices=0
>>PrivateComputeServices=0
>>PixelThemes=0
>>EmojiWallpaper=0
>>PixelWeather=0
>>AICore=0

PlayGames=0
GoogleRecorder=0

GoogleFiles=0
>>GoogleFiles=0
>>StorageManager=0
>>DocumentsUIGoogle=0

MarkupGoogle=0
GoogleTTS=0

# --- SEARCH AND AI ASSISTANT (ENABLE VELVET AND GEMINI) ---

GoogleSearch=1
>>Velvet=1
>>Gemini=1

GoogleSounds=0

GoogleChrome=0
>>GoogleChrome=0
>>WebViewGoogle=0
>>TrichromeLibrary=0

# --- GMAIL (ENABLE) AND SYSTEM SERVICES ---

Gmail=1
DeviceSetup=1
AndroidAuto=0
GoogleFeedback=0
GooglePartnerSetup=1
AndroidDevicePolicy=0

# --- DISABLE GO VERSIONS AND ADDITIONAL SOFTWARE ---

CoreGo=0
GoogleGo=0
AssistantGo=0
MapsGo=0
NavigationGo=0
GalleryGo=0
GmailGo=0

PixelSetupWizard=0
Meet=0
GoogleDocs=0
GoogleSheets=0
GoogleSlides=0
YouTube=0
YouTubeMusic=0
Books=0
GoogleTalkback=0
GooglePersonalSafety=0

